# Copy to .env (in the project root) and fill in what you need.
# Nothing here is needed for the local demo: the defaults work out of the box.

# ---------------- Smart contract / Hardhat ----------------
# Sepolia RPC endpoint (Alchemy, Infura, etc.)
SEPOLIA_RPC_URL=
# Private key of the account that deploys the contract (needs Sepolia ETH). NEVER commit it.
DEPLOYER_PRIVATE_KEY=
# Optional: verify the contract on Etherscan after deploying
ETHERSCAN_API_KEY=
# Optional: USD prices in the gas report
COINMARKETCAP_API_KEY=
# Set to true to compile with the solc-js npm build instead of downloading solc (behind firewalls)
SOLC_FROM_NPM=false

# ---------------- Access Gateway ----------------
# Which deployment file to use: shared/deployments/<NETWORK>.json  (localhost | sepolia)
NETWORK=localhost
GATEWAY_PORT=4000
# RPC the gateway reads the chain from (defaults to http://127.0.0.1:8545 for localhost, SEPOLIA_RPC_URL for sepolia)
RPC_URL=
# Gateway signer: pays gas for logAccess. Defaults to Hardhat account #1 on localhost.
# On Sepolia use a separate funded key; the deploy script authorises its address.
GATEWAY_PRIVATE_KEY=
# Comma-separated list of web-app origins allowed by CORS, and hosts allowed in Sign-In with Ethereum messages
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SIWE_DOMAINS=localhost:5173,127.0.0.1:5173
# Write an AccessLogged event on-chain for every released file (true/false)
LOG_ACCESS_ONCHAIN=true
# IPFS backend: mock (local folder, no install), kubo (local IPFS node) or pinata
IPFS_MODE=mock
IPFS_API_URL=http://127.0.0.1:5001
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# ---------------- Frontend (Vite reads VITE_* from this file) ----------------
VITE_NETWORK=localhost
VITE_GATEWAY_URL=http://localhost:4000
